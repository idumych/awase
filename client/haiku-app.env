# haiku-app.env — what the beos-app-platforms release tools need to know about Awase.
# Shell syntax: sourced by packaging/*.sh, the CI workflows and the release scripts
# (check-artifact.sh, release-gate.sh). The app lives in client/ of the repo: run the
# tools from here, and the workflows in ../.github/workflows cd here first.

# ── Identity ──
APP_NAME="Awase"
APP_CMD="awase"
APP_SIG="application/x-vnd.Awase"
RDEF="Awase.rdef"

PLATFORMS="haiku linux"                # plus VitruvianOS .debs (deb.yml), on request
APP_PATH="apps/Awase"
DESKBAR_NAME="Awase"

# ── Version (also in Awase.rdef app_version) ──
VERSION="0.3.0"
REVISION="1"

# ── Package metadata ──
SUMMARY="Lend your computer's idle time to build Renku OS packages"
DESCRIPTION_FILE="packaging/description.txt"
HOMEPAGE="https://github.com/idumych/awase"
GITHUB_REPO="idumych/awase"
LICENSE_NAME="MIT"
COPYRIGHT="2026 Ian Dumych"
PACKAGER="idumych <19998719+idumych@users.noreply.github.com>"

# Runtime dependencies beyond the Haiku API: libcurl, for the coordinator's HTTPS API
HPKG_REQUIRES_EXTRA="lib:libcurl"
# Renku arm64 has curl in its ports repository, so the arm64 package requires it too
HPKG_REQUIRES_ARM64="lib:libcurl"
# Renku arm64 ports the sysroot needs besides gcc_syslibs, icu and zlib
HPKG_ARM64_PORTS="curl curl_devel"
DESKTOP_CATEGORIES="Network;Development;"
APPIMAGE_MUST_BUNDLE="libcurl"
# The seal's 合 and the serif names: IPAGothic has the kanji and kana as a .ttf
APPIMAGE_FONTS_EXTRA="NotoSerif-Bold ipag"
APPIMAGE_TRANSLATORS=""
COSMOE_REPO=""
COSMOE_TAG=""
SMOKE_ARGS=""                          # starts in the demo pool, which needs no server
SMOKE_WINDOW=""
SMOKE_PROCESS=""
APPIMAGE_APT_EXTRA="libcurl4-openssl-dev fonts-noto-core fonts-ipafont-gothic"

# ── VitruvianOS (.deb, deb.yml) ──
DEB_SECTION="net"
DEB_DEPENDS_EXTRA="libcurl4t64"
DEB_APT_EXTRA="libcurl4-openssl-dev"

# ── Build ──
HPKG_BUILD_DEPS="curl_devel"
TEST_CMD="make test"
TYPECHECK_SRCS="app/*.cpp"
TYPECHECK_INCLUDES="app core"
TYPECHECK_CXXFLAGS="-std=c++17"

# ── Feature test (release/test-plan.md) ──
FEATURE_CHECKS="demo coordinator"
EVIDENCE_1="{p}-demo.txt|sealed"
EVIDENCE_2="{p}-portal.log|POST /api/client/jobs/[0-9]+/complete"
