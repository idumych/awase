resource app_signature "application/x-vnd.Awase";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major = 0,
	middle = 1,
	minor = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Awase",
	long_info = "Awase 0.1: volunteer package builds for Renku OS (demo pool)"
};

resource file_types message {
	"types" = "application/x-vnd.Awase"
};
